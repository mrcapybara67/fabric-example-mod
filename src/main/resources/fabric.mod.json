{
	"schemaVersion": 1,
	"id": "capy",
	"version": "${version}",
	"name": "Capy Client",
	"description": "Sakura-themed Minecraft client with a configurable ClickGUI and the Anti Admin proximity alert module.",
	"authors": [
		"Capy"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/capy/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.capy.client.CapyClient"
		]
	},
	"mixins": [
		{
			"config": "capy.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
